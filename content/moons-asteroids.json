          "label": "평균 지름",
          "value": "약 5,260 km",
          "source": "nasa-ganymede"
        },
        {
          "label": "달 중 크기",
          "value": "태양계에서 가장 커요",
          "source": "nasa-ganymede"
        },
        {
          "label": "작은 행성과 비교",
          "value": "수성보다 지름이 커요",
          "source": "nasa-ganymede",
          "detail": true
        }
      ],
      "sources": [
