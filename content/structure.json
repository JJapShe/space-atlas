{
  "categories": [
    {
      "id": "planet",
      "name": "행성",
      "aliases": [
        "태양계 행성",
        "planet"
      ],
      "summary": "우리 태양계에는 태양 주위를 도는 둥근 행성이 여덟 개 있어요.",
      "traits": [
        "수성부터 화성까지는 바위로 된 단단한 표면이 있어요.",
        "목성과 토성은 가스로 된 거대한 행성이에요. 천왕성과 해왕성은 얼음이 될 수 있는 물질이 많은 거대한 행성이에요."
      ],
      "sources": [
        "nasa-planets"
      ]
    },
    {
      "id": "exoplanet",
      "name": "외계행성",
      "aliases": [
        "exoplanet",
        "extrasolar planet"
      ],
      "summary": "태양계 밖에서 찾은 행성이에요. 이 도감에는 다른 별이나 갈색왜성 주위를 도는 행성이 나와요.",
      "traits": [
        "행성이 별 앞을 지나면 별빛을 조금 가려요. 그 모습을 보고 행성을 찾을 수 있어요.",
        "지구보다 작은 행성도 있고, 훨씬 큰 행성도 있어요."
      ],
      "sources": [
        "nasa-exoplanets"
      ]
    },
    {
      "id": "dwarf",
      "name": "왜행성",
      "aliases": [
        "왜소행성",
        "dwarf planet"
      ],
      "summary": "태양 주위를 도는 둥근 천체예요. 도는 길 주변에는 다른 작은 천체들이 남아 있어요.",
      "traits": [
        "왜소행성이라고도 불러요.",
        "왜행성 주위를 도는 작은 위성이 있을 수도 있어요."
      ],
      "sources": [
        "nasa-planets",
        "nasa-moons",
        "kasi-solar-overview"
      ]
    },
    {
